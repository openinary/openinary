{
  "name": "shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./auth-client": {
      "types": "./src/auth-client-only.ts",
      "import": "./dist/auth-client-only.js",
      "default": "./dist/auth-client-only.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc && cp -R src/generated dist/generated && node scripts/add-js-extensions.cjs",
    "type-check": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test src/db/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate-deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.23",
    "@prisma/client": "^6.17.0",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "prisma": "^6.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}
