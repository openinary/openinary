# Local development only, loaded by Next.js when running `pnpm dev:web` or `pnpm dev`.
# Copy this file to .env and fill in the values.
# Do NOT use this file for Docker/production. Use the .env at the repo root instead.

NODE_ENV=development

# BETTER_AUTH_SECRET is auto-generated in Docker. Override here if needed:
BETTER_AUTH_SECRET=your-custom-secret-key-here
BETTER_AUTH_URL=http://localhost:3001

# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Opt-in Postgres instead of the SQLite file. Unset = SQLite (data/auth.db at
# the repo root, or DB_PATH). Keep identical in apps/api/.env.
# See docs/configuration/database.
# DATABASE_URL=postgres://postgres@localhost:5432/openinary
# DATABASE_POOL_MAX=5

# ============================================
# Users & single sign-on (optional)
# ============================================
# Keep these identical in apps/api/.env. This app serves /api/auth, so the
# redirect URI to register at the provider is
# ${BETTER_AUTH_URL}/api/auth/callback/<id>, e.g. http://localhost:3001/api/auth/callback/google
# See docs/configuration/authentication for every option.
# AUTH_PROVIDERS=google
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_ALLOWED_EMAIL_DOMAINS=acme.com
# AUTH_DEFAULT_ROLE=viewer
# AUTH_ADMIN_EMAILS=you@acme.com
# AUTH_PASSWORD_LOGIN=true
