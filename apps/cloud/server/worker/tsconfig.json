{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "../shared/**/*.ts",
    "../scripts/**/*.ts",
    "../worker-configuration.d.ts"
  ]
}
