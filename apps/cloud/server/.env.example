DATABASE_URL=
DATABASE_URL_POOLER=
CORS_ORIGIN=http://localhost:3001
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admin panel (apps/admin). ADMIN_USER_ID is the one account allowed through
# /admin/* and every adminProcedure - copy your own `user.id` out of the DB
# after signing in once. Leave it unset and the admin panel refuses everyone.
ADMIN_ORIGIN=http://localhost:3002
ADMIN_USER_ID=

# Public alpha switch. Only consulted on *.openinary.dev deployments (prod
# sets it in wrangler.jsonc vars); local dev always accepts signups.
# ALLOW_PUBLIC_SIGNUP=true

# Telegram ping on every new account (api/lib/push.ts). Same bot as the
# marketing site's lead notifications. In production both are Worker secrets:
# `wrangler secret put TELEGRAM_BOT_TOKEN` / `wrangler secret put TELEGRAM_CHAT_ID`.
# Unset = no pings, signups unaffected.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth - from Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI must be: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave unset to hide/disable the Google sign-in button's backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Autumn (billing/usage) - sandbox secret key from the Autumn dashboard.
# In production set via `wrangler secret put AUTUMN_SECRET_KEY`.
AUTUMN_SECRET_KEY=

# Cloudflare R2 (or any S3-compatible storage) used by @openinary/core for the
# image transformation demo. R2_ENDPOINT looks like:
# https://<account_id>.r2.cloudflarestorage.com
#
# Two buckets, one per environment: openinary-storage-dev here, and
# openinary-cloud-storage in production (the Worker binding in wrangler.jsonc,
# plus `wrangler secret put R2_BUCKET_NAME`). Never point this at the
# production bucket - the container writes and deletes through it.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=openinary-storage-dev
R2_ENDPOINT=

# Cloudflare Turnstile - secret key from the Turnstile dashboard. Guards
# email sign-up. Leave unset to disable the captcha check (local dev).
# In production set via `wrangler secret put TURNSTILE_SECRET_KEY`.
TURNSTILE_SECRET_KEY=

# Attio (CRM) - workspace API key, from Settings > Developers > Access tokens.
# Read by the admin panel to list the cloud-waitlist and to drop a person's
# record when their account is deleted. Unset = those two panels stay empty and
# account deletion skips the CRM step.
# In production set via `wrangler secret put ATTIO_API_KEY`.
ATTIO_API_KEY=

# Loops (lifecycle email) - API key from Settings > API. Needs the workflow
# API enabled for the team, otherwise every /v1/workflows call answers 401.
#
# Read by api/lib/loops.ts on signup and by the daily cron, and by
# api/scripts/loops-build.ts, which is what actually creates the sequences.
# Unset = no contacts, no events, no builds; signups are unaffected either way.
# In production set via `wrangler secret put LOOPS_API_KEY`.
LOOPS_API_KEY=
