{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openinary-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "admin.openinary.dev", "custom_domain": true }],
  // Production lives on the custom domain only. Left undeclared, a deploy
  // silently re-enables both of these.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
