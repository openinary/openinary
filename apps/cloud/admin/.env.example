# Same API as the customer dashboard - auth and oRPC are shared. This origin
# must also be the server's ADMIN_ORIGIN, or its cookies and CORS preflights
# are rejected.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where a signed-out visitor is sent. There is no sign-in form here: the
# session cookie is shared across subdomains, so signing in on the customer
# dashboard signs you in here too.
NEXT_PUBLIC_APP_URL=http://localhost:3001
