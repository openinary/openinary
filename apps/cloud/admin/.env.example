# Same API as the customer dashboard - auth and oRPC are shared. This origin
# must also be the server's ADMIN_ORIGIN, or its cookies and CORS preflights
# are rejected.
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Where a signed-out visitor is sent. There is no sign-in form here: the
# session cookie is shared across subdomains, so signing in on the customer
# dashboard signs you in here too.
NEXT_PUBLIC_APP_URL=http://localhost:3101

# Autumn dashboard the user page links customers to. Point it at the
# environment the server's AUTUMN_SECRET_KEY belongs to (sandbox by default;
# set it to the live dashboard URL in production).
# NEXT_PUBLIC_AUTUMN_DASHBOARD_URL=https://app.useautumn.com/sandbox
