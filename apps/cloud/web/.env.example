NEXT_PUBLIC_SERVER_URL=http://localhost:3100
# Cloudflare Turnstile site key (public). Must be set together with the
# server's TURNSTILE_SECRET_KEY; unset = no widget, no captcha check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cossistant public key (pk_...), from the widget's install page. Unset = no
# support widget in the dashboard.
NEXT_PUBLIC_COSSISTANT_API_KEY=
