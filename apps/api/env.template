# Local development only, loaded by the Hono API server when running `pnpm dev:api` or `pnpm dev`.
# Copy this file to .env and fill in the values.
# Do NOT use this file for Docker/production. Use the .env at the repo root instead.

NODE_ENV=development

# Log level: trace, debug, info, warn, error, fatal
# Defaults to 'info' in production, 'debug' in development
# LOG_LEVEL=debug

# BETTER_AUTH_SECRET is auto-generated in Docker. Override here if needed:
# BETTER_AUTH_SECRET=your-custom-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Mode: "fullstack" = with web UI (default), "api" = API standalone (auto-generates API key)
# MODE=fullstack

# Signs delivery URLs and presigned uploads (POST /upload/sign).
# At least 16 characters; generate one with: openssl rand -hex 32
# API_SECRET=your-strong-secret-key-here-at-least-16-chars

# PORT=3000

# CORS_ORIGIN=http://localhost:3001

# Path to the SQLite auth database
# DB_PATH=/app/data/auth.db

# ============================================
# Users & single sign-on (optional)
# ============================================
# Keep these identical in apps/web/.env: the web app serves /api/auth (sign-in
# and the SSO callbacks), the API enforces the same policy on every request.
# Redirect URI to register at the provider: ${BETTER_AUTH_URL}/api/auth/callback/<id>
# (in dev that is the web app, e.g. http://localhost:3001/api/auth/callback/google).
# See docs/configuration/authentication for every option.
# AUTH_PROVIDERS=google
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_ALLOWED_EMAIL_DOMAINS=acme.com
# AUTH_DEFAULT_ROLE=viewer
# AUTH_ADMIN_EMAILS=you@acme.com
# AUTH_PASSWORD_LOGIN=true

# ============================================
# S3-Compatible Storage
# ============================================
# STORAGE_BUCKET_NAME=your-bucket-name
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=your-access-key
# STORAGE_SECRET_ACCESS_KEY=your-secret-key
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_PUBLIC_URL=https://your-cdn-or-bucket-url.com

# ============================================
# Storage HTTP connection settings
# ============================================
# STORAGE_MAX_SOCKETS=50
# STORAGE_CONNECTION_TIMEOUT=0
# STORAGE_REQUEST_TIMEOUT=0
# STORAGE_SOCKET_TIMEOUT=0

# ============================================
# Upload Configuration
# ============================================
# Maximum file size for uploads in megabytes (default: 50)
# Increase for large video uploads in self-hosted setups
# MAX_FILE_SIZE_MB=50

# ============================================
# Rate Limiting
# ============================================
# PUBLIC_RATE_LIMIT_MAX=100
# PUBLIC_RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Video Processing
# ============================================
# Maximum concurrent video jobs (auto-detected from system RAM: 1 per 2GB, max 16)
# VIDEO_MAX_CONCURRENT=2
# VIDEO_JOB_RETRY_MAX=3
# VIDEO_JOB_CLEANUP_HOURS=24
# VIDEO_WORKER_POLL_INTERVAL_MS=1000

# ============================================
# OpenTelemetry export (Optional)
# ============================================
# Off by default. Point it at an OTLP/HTTP endpoint you run (an OpenTelemetry
# Collector, Grafana Alloy, a vendor intake) to export delivery request counts,
# transformations and per-request delivery logs. Nothing goes to the project.
# See docs/configuration/opentelemetry.mdx.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=openinary
# Keep the metrics, drop the per-request log records (they carry file paths):
# OPENINARY_OTEL_DELIVERY_LOGS=false
