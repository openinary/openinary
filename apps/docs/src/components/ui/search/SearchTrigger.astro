---
/**
 * Opens the search dialog (⌘K on macOS, Ctrl+K elsewhere). It sits at the top
 * of the sidebar, drawn as the dashboard's Input (packages/ui/src/ui/input.tsx):
 * the header stays the marketing site's, which has no search.
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
---

<button
  data-slot="search-trigger"
  data-search-trigger
  type="button"
  class="flex h-8 w-full items-center gap-2 rounded-[8px] border border-field-border bg-field ps-2.5 pe-1.5 text-start text-[13px] text-field-placeholder outline-none transition-[border-color,box-shadow] hover:border-field-border-hover focus-visible:border-field-focus focus-visible:ring-[3px] focus-visible:ring-field-focus/20 focus-visible:outline-none"
  aria-keyshortcuts="Control+K"
>
  <Icon name="lucide:search" class="size-3.5 shrink-0" />
  <span class="flex-1 truncate">Search</span><span class="sr-only"> documentation</span>
  <kbd aria-hidden="true" dir="ltr" class="inline-flex h-5 items-center gap-0.5 rounded border border-field-border px-1 font-mono text-[0.6875rem] font-medium leading-none">
    <span data-shortcut-key>Ctrl</span>K
  </kbd>
</button>

<script>
  import "./search-trigger.client";
</script>
