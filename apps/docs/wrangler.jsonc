{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "none"
  },
  // Served at openinary.dev/docs. The marketing Worker owns the hostname as a
  // custom domain; a route on the same hostname takes precedence over it, so
  // this Worker answers /docs and everything under it, and nothing else.
  // www.openinary.dev is the same site, so it needs the same route.
  "routes": [
    { "pattern": "openinary.dev/docs*", "zone_name": "openinary.dev" },
    { "pattern": "www.openinary.dev/docs*", "zone_name": "openinary.dev" }
  ],
  // Production lives on that route only (same reason as the marketing Worker).
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
