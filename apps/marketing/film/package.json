{
  "name": "openinary-film",
  "private": true,
  "type": "module",
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "@remotion/fonts": "4.0.530",
    "@remotion/mac-cursors": "4.0.530",
    "@remotion/media": "4.0.530",
    "@remotion/paths": "4.0.530",
    "lucide-react": "1.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "studio": "remotion studio",
    "assets": "python3 scripts/make-assets.py",
    "cues": "tsx scripts/export-cues.ts",
    "score": "python3 audio/pack/mix.py",
    "still": "remotion still Film169 out/still.png --frame=345",
    "render": "remotion render Film169 out/Film169.mp4 --crf=14",
    "check": "tsx scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "render:dark": "remotion render Film169Dark out/Film169Dark.mp4 --crf=14"
  }
}
