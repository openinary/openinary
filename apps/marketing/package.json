{
  "name": "marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3200",
    "lint": "eslint .",
    "prebuild": "pnpm --filter @openinary/plans build && pnpm --filter registry run registry:build && node ../../scripts/sync-registry-block.mjs marketing",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "node --import tsx scripts/pricing-check.mjs && node --import tsx scripts/github-check.mjs"
  },
  "dependencies": {
    "@openinary/plans": "workspace:*",
    "@opennextjs/cloudflare": "^1.19.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lenis": "1.3.27",
    "lucide-react": "^0.536.0",
    "motion": "^12.23.26",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.407.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  }
}
